#!/bin/sh

key="/etc/ssl/private/pool-controller.key"
cert="/etc/ssl/certs/pool-controller.crt"
name="pool-controller"
bin="/home/pi/go/bin/$name"
unit="$name.service"

useradd -U -M -s /bin/false homekit 2>/dev/null || true
ln -f -s $bin /usr/local/bin/$name

# This host runs systemd. The SysV script in this directory is leftover and
# is not what starts the daemon; leave it in git but do not install it, or
# systemd would generate a second unit that fights this one.
if [ -f /etc/init.d/$name ]; then
    rm -f /etc/init.d/$name /etc/rc*.d/???$name
fi

echo "installing $unit"
cp -f $unit /etc/systemd/system/$unit
chmod 0644 /etc/systemd/system/$unit
chown root:root /etc/systemd/system/$unit
systemctl daemon-reload
systemctl enable $name

if [ ! -f $cert ]; then
    openssl req -newkey rsa:4096 -nodes -keyout $key -x509 -days 3650 -out $cert
fi
